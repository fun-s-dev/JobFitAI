# ==============================================================================
# JobFitAI v2 — Frontend Environment Configuration Example
# Copy this file to .env or set environment variables in your deployment host.
# ==============================================================================

# Backend API URL
# Leave empty ("") when deployed behind Vercel or Netlify reverse proxy (same-origin /api/*)
# Set to "http://localhost:3000" during standalone local development without proxy
VITE_API_URL=

# Optional alias for VITE_API_URL
VITE_API_BASE_URL=
