# ==============================================================================
# JobFitAI v2 — Backend Environment Configuration Example
# Copy this file to .env and provide your specific credentials.
# NO REAL SECRETS IN THIS FILE.
# ==============================================================================

# Server & Environment
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
TRUST_PROXY_HOPS=1

# Database & Authentication
# For local Docker: mongodb://mongo:27017/jobfitai
# For local standalone: mongodb://127.0.0.1:27017/jobfitai
# For MongoDB Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/jobfitai?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/jobfitai
JWT_SECRET=replace_with_a_secure_random_string_of_at_least_32_characters_minimum

# Registration & Access Control
REGISTRATION_OPEN=true
INVITE_CODE=

# Google Gemini API & Pinned Models
# Get your API key from Google AI Studio: https://aistudio.google.com/
GOOGLE_GENAI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMS=768
LLM_TIMEOUT_MS=30000
LLM_GENERATE_RPM=10
LLM_EMBED_RPM=80
LLM_CONCURRENCY=5
EMBEDDING_CACHE_TTL_DAYS=90

# Budget Guards (Daily Quotas Reset at Midnight Pacific Time)
USER_DAILY_VERIFICATIONS=3
LLM_DAILY_BUDGET=400
EMBEDDING_DAILY_BUDGET=800

# Rate Limiting (per user/IP in 15-minute windows)
RATE_LIMIT_DRAFT_WINDOW_MS=900000
RATE_LIMIT_DRAFT_MAX=10
RATE_LIMIT_VERIFY_WINDOW_MS=900000
RATE_LIMIT_VERIFY_MAX=10
RATE_LIMIT_GITHUB_WINDOW_MS=900000
RATE_LIMIT_GITHUB_MAX=10

# GitHub Evidence Extraction (Optional Personal Access Token to avoid 60 req/hr IP rate limits)
GITHUB_TOKEN=

# Verification Calibration Thresholds & Weights
THRESHOLD_VERIFIED=0.8
THRESHOLD_REVIEW=0.5
SIM_LO=0.5
SIM_HI=0.9
W_SIM=0.30
W_ENT=0.40
W_PROJ=0.30
W_SIM_NOGH=0.40
W_ENT_NOGH=0.60

# Natural Language Inference (Entailment) & Grounding
ENTAILMENT_THINKING_LEVEL=LOW
ENTAILMENT_SCORE_YES=1.0
ENTAILMENT_SCORE_PARTIAL=0.5
ENTAILMENT_SCORE_NO=0.0
QUOTE_GROUNDING_THRESHOLD=0.90
MAX_EVIDENCE_CHUNKS=3
MAX_CHUNK_CHARS=500

# PDF Generation & Security
PDF_RENDERING_ENABLED=true
PUPPETEER_NO_SANDBOX=false

# Structured Logging (fatal, error, warn, info, debug, trace, silent)
LOG_LEVEL=info